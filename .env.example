# ─────────────────────────────────────────────────────────
#  JARVIS BACKEND — variabile de mediu
#  Copiaza in Railway → Variables. NU comite .env real in git.
# ─────────────────────────────────────────────────────────

# --- Claude API (OBLIGATORIU) ---
# Cheia ta de pe console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelul folosit pentru sinteza si chat (constitutie: stack fixat)
CLAUDE_MODEL=claude-sonnet-4-6

# --- Telegram (OBLIGATORIU) ---
# Token de la @BotFather (vezi README pas 2)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Chat ID-ul TAU (vezi README pas 3). Doar tu poti comanda botul.
TELEGRAM_OWNER_CHAT_ID=123456789

# --- Operational MCP (OBLIGATORIU pt task-uri) ---
# URL-ul connectorului tau Operational (cel cu token in path)
OPERATIONAL_MCP_URL=https://web-production-81ea8.up.railway.app/mcp/PUNE_AICI_TOKENUL

# --- FAZA 2: Memorie persistenta ---
# Railway o injecteaza automat daca ai adaugat addon-ul Postgres
# si ai setat referinta: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Embeddings pentru memoria semantica (OPTIONAL — fara cheie, memoria
# functioneaza cu cautare text). Cheie de pe dash.voyageai.com (tier gratuit).
VOYAGE_API_KEY=

# Directorul de backup zilnic (volumul Railway montat pe /data)
BACKUP_DIR=/data/backups

# --- FAZA 2: Google (un OAuth, trei scope-uri: Calendar+Gmail+Drive) ---
# Vezi README sectiunea "Google" — rulezi local scripts/google-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Folderul Drive dedicat (readonly)
GOOGLE_DRIVE_FOLDER=JARVIS

# Expeditori-cheie pentru clasificarea emailurilor (suplimentar celor predefiniti)
# GMAIL_KEY_SENDERS=anaf.ro,bancatransilvania.ro,notar,avocat

# --- Vreme (are deja default Sibiu, nu obligatoriu) ---
WEATHER_LAT=45.7983
WEATHER_LON=24.1256
WEATHER_CITY=Sibiu

# --- CODEX Faza 4.6: canale REALE, separate deliberat (ambele implicit OFF) ---
# on/true → UN digest executiv pe zi (07:40), pe Telegram; nimic daca nu e relevant
FOUNDER_DAILY_DIGEST_ENABLED=false
# alertele interruptive NU au cale de trimitere inca; flag rezervat, ramane OFF
FOUNDER_INTERRUPTIVE_ALERTS_ENABLED=false

# --- CODEX Faza 4.4: Founder Attention Gate (implicit sigur: nu ruleaza) ---
# on/true → episoadele trec prin gate (IGNORE/AUDIT/DIGEST/ALERT/DECISION) — doar in audit
FOUNDER_ATTENTION_GATE_ENABLED=false
# implicit ON: candidatii si digestul raman DOAR in audit/jarvis_state
FOUNDER_ATTENTION_SHADOW_MODE=true
# notificarile REALE — raman OFF pana la aprobarea explicita a lui Adrian
FOUNDER_NOTIFICATIONS_ENABLED=false

# --- CODEX Faza 4.2: Proactive CEO Pipeline (implicit sigur: nu ruleaza) ---
# on/true → observatiile emise trec prin triaj → episoade → preview Board + CEO Brief
PROACTIVE_CEO_PIPELINE_ENABLED=false
# implicit ON: totul DOAR in audit/jarvis_state (zero notificari)
PROACTIVE_CEO_SHADOW_MODE=true
# etape ulterioare — raman OFF pana la validare + aprobare
PROACTIVE_CEO_NOTIFICATIONS_ENABLED=false
PROACTIVE_CEO_BOARD_EXECUTION_ENABLED=false

# --- CODEX Faza 4: Observation Engine (implicit sigur: motorul NU ruleaza) ---
# on/true → motorul ruleaza (rapid ~45min, zilnic 06:45, saptamanal luni 06:30)
OBSERVATION_ENGINE_ENABLED=false
# implicit ON: cand ruleaza, scrie DOAR in audit/jarvis_state (zero notificari)
OBSERVATION_ENGINE_SHADOW_MODE=true
# etape ulterioare — raman OFF pana la validare + aprobare
OBSERVATION_NOTIFICATIONS_ENABLED=false
OBSERVATION_BOARD_ESCALATION_ENABLED=false
# OBSERVATION_INTERVAL_MINUTES=45

# --- CODEX Faza 3: Executive Board (ambele implicit OFF = comportament identic) ---
# on/true → raportul Executive Board pe ruta "consiliu"/"board" (consultativ, nu executa)
EXECUTIVE_BOARD_ENABLED=false
# on/true (cu ENABLED=false) → consiliul raspunde ca acum, Boardul analizeaza in fundal DOAR in audit_log
EXECUTIVE_BOARD_SHADOW_MODE=false

# --- Server ---
PORT=3000

# --- Aplicatia HUD (PWA) ---
# PIN-ul cu care intri in aplicatie. Daca lipseste, API-ul /api e oprit.
APP_SECRET=

# --- NERVOUS SYSTEM V1 (organismul managerial; totul gated) ---
# on/true → ciclurile 07:10 + 15:30 + reactive ruleaza (shadow implicit)
CEO_NERVOUS_SYSTEM_ENABLED=false
# shadow (implicit — simuleaza, zero task real) | information (doar cu flagul de mai jos)
CEO_TASK_AUTONOMY=shadow
# true → CEO AI poate crea AUTONOM doar INFORMATION TASKS (decizia lui Adrian; NU activa fara shadow validat)
CEO_AUTONOMOUS_INFORMATION_TASKS_ENABLED=false
# on → kill switch: opreste instant orice scriere a sistemului nervos
CEO_NERVOUS_KILL_SWITCH=off
# limite pentru activarea controlata (implicit 5/zi total, 2/zi per persoana)
# CEO_NERVOUS_DAILY_LIMIT=5
# CEO_NERVOUS_PER_PERSON_LIMIT=2

# --- SELF-EVOLUTION V1 (capability builder; totul shadow, zero build real) ---
# on/true → scanarea de evolutie ruleaza dupa ciclul Nervous + manual
CEO_SELF_EVOLUTION_ENABLED=false
# on → kill switch evolutie (opreste scanarile instant)
CEO_EVOLUTION_KILL_SWITCH=off
# limite build-uri (implicit conservator: 2/zi, 1 concurent, 10 USD)
# CEO_EVOLUTION_MAX_BUILDS_PER_DAY=2
# CEO_EVOLUTION_MAX_CONCURRENT_BUILDS=1
# CEO_EVOLUTION_MAX_COST_USD=10
# NOTA: politica de deploy NU e configurabila — PRODUCTION_DEPLOYMENT_REQUIRES_
# ADRIAN_APPROVAL e constanta inghetata in src/ceo/evolution/contract.js (§22).

# --- AUTONOMOUS TEAM MANAGEMENT (politica fondatorului, 21 iul 2026) ---
# Faza B: information tasks autonome / Faza C: verificari interne low-risk
CEO_AUTONOMOUS_INFORMATION_TASKS_ENABLED=false
CEO_AUTONOMOUS_OPERATIONAL_TASKS_ENABLED=false
# Kill switch unic (§20; aliasul vechi CEO_NERVOUS_KILL_SWITCH ramane valid)
CEO_AUTONOMOUS_TASKS_KILL_SWITCH=off
