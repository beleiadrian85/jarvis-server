# ─────────────────────────────────────────────────────────
#  JARVIS BACKEND — variabile de mediu
#  Copiaza in Railway → Variables. NU comite .env real in git.
# ─────────────────────────────────────────────────────────

# --- Claude API (OBLIGATORIU) ---
# Cheia ta de pe console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelul folosit pentru sinteza si chat (constitutie: stack fixat)
CLAUDE_MODEL=claude-sonnet-4-6

# --- Telegram (OBLIGATORIU) ---
# Token de la @BotFather (vezi README pas 2)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Chat ID-ul TAU (vezi README pas 3). Doar tu poti comanda botul.
TELEGRAM_OWNER_CHAT_ID=123456789

# --- Operational MCP (OBLIGATORIU pt task-uri) ---
# URL-ul connectorului tau Operational (cel cu token in path)
OPERATIONAL_MCP_URL=https://web-production-81ea8.up.railway.app/mcp/PUNE_AICI_TOKENUL

# --- FAZA 2: Memorie persistenta ---
# Railway o injecteaza automat daca ai adaugat addon-ul Postgres
# si ai setat referinta: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Embeddings pentru memoria semantica (OPTIONAL — fara cheie, memoria
# functioneaza cu cautare text). Cheie de pe dash.voyageai.com (tier gratuit).
VOYAGE_API_KEY=

# Directorul de backup zilnic (volumul Railway montat pe /data)
BACKUP_DIR=/data/backups

# --- FAZA 2: Google (un OAuth, trei scope-uri: Calendar+Gmail+Drive) ---
# Vezi README sectiunea "Google" — rulezi local scripts/google-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Folderul Drive dedicat (readonly)
GOOGLE_DRIVE_FOLDER=JARVIS

# Expeditori-cheie pentru clasificarea emailurilor (suplimentar celor predefiniti)
# GMAIL_KEY_SENDERS=anaf.ro,bancatransilvania.ro,notar,avocat

# --- Vreme (are deja default Sibiu, nu obligatoriu) ---
WEATHER_LAT=45.7983
WEATHER_LON=24.1256
WEATHER_CITY=Sibiu

# --- Server ---
PORT=3000

# --- Aplicatia HUD (PWA) ---
# PIN-ul cu care intri in aplicatie. Daca lipseste, API-ul /api e oprit.
APP_SECRET=
